# Nginx Yapılandırma Örneği - SSL OLMADAN
# Bu dosyayı /etc/nginx/sites-available/iot-analytics olarak kaydedin
# Domain: devrekbenimmarketim.com için hazırlanmıştır
# SSL sertifikası KALDIRILMIŞ - Sadece HTTP (Port 80)

# HTTP Server - ESP8266 için (Port 80)
server {
    listen 80;
    server_name iot.devrekbenimmarketim.com;  # IoT subdomain

    # Log dosyaları
    access_log /var/log/nginx/iot-analytics-access.log;
    error_log /var/log/nginx/iot-analytics-error.log;

    # Maksimum upload boyutu
    client_max_body_size 1M;

    # ÖNEMLİ: HTTP'den HTTPS'e yönlendirme YOK
    # return 301 https://... satırları OLMAMALI

    location / {
        proxy_pass http://localhost:3001;  # IoT projesinin portu
        
        proxy_http_version 1.1;
        
        # WebSocket desteği
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        
        # Headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Timeout ayarları
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        
        # Cache bypass
        proxy_cache_bypass $http_upgrade;
    }

    # Static dosyalar için cache (opsiyonel)
    location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg)$ {
        proxy_pass http://localhost:3001;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}

# SSL/HTTPS BLOĞU YOK - ESP8266 için gerekli değil

