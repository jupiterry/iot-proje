# Nginx Yapılandırma Örneği
# Bu dosyayı /etc/nginx/sites-available/iot-analytics olarak kaydedin

server {
    listen 80;
    server_name iot.yourdomain.com;  # Kendi domain'inizi yazın

    # Log dosyaları
    access_log /var/log/nginx/iot-analytics-access.log;
    error_log /var/log/nginx/iot-analytics-error.log;

    # Maksimum upload boyutu
    client_max_body_size 1M;

    location / {
        proxy_pass http://localhost:3001;  # IoT projesinin portu
        
        proxy_http_version 1.1;
        
        # WebSocket desteği
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        
        # Headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Timeout ayarları
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        
        # Cache bypass
        proxy_cache_bypass $http_upgrade;
    }

    # Static dosyalar için cache (opsiyonel)
    location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg)$ {
        proxy_pass http://localhost:3001;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}

# SSL yapılandırması (Let's Encrypt sonrası otomatik eklenir)
# server {
#     listen 443 ssl http2;
#     server_name iot.yourdomain.com;
#     
#     ssl_certificate /etc/letsencrypt/live/iot.yourdomain.com/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/iot.yourdomain.com/privkey.pem;
#     
#     # ... yukarıdaki location bloğu buraya da eklenir
# }

