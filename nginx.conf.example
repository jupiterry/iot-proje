# Nginx Yapılandırma Örneği
# Bu dosyayı /etc/nginx/sites-available/iot-analytics olarak kaydedin
# Domain: devrekbenimmarketim.com için hazırlanmıştır

# HTTP Server - ESP8266 için HTTP desteği (301 redirect yok)
server {
    listen 80;
    server_name iot.devrekbenimmarketim.com;  # IoT subdomain

    # Log dosyaları
    access_log /var/log/nginx/iot-analytics-access.log;
    error_log /var/log/nginx/iot-analytics-error.log;

    # Maksimum upload boyutu
    client_max_body_size 1M;

    # HTTP'den HTTPS'e yönlendirme YOK (ESP8266 için gerekli)
    # return 301 https://$server_name$request_uri;  # Bu satırı SİLİN veya yorum satırı yapın

    location / {
        proxy_pass http://localhost:3001;  # IoT projesinin portu
        
        proxy_http_version 1.1;
        
        # WebSocket desteği
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        
        # Headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Timeout ayarları
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        
        # Cache bypass
        proxy_cache_bypass $http_upgrade;
    }

    # Static dosyalar için cache (opsiyonel)
    location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg)$ {
        proxy_pass http://localhost:3001;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}

# HTTPS Server - Tarayıcılar için (opsiyonel)
# ESP8266 HTTP kullanıyorsa bu blok gerekli değil
# server {
#     listen 443 ssl http2;
#     server_name iot.devrekbenimmarketim.com;
#     
#     ssl_certificate /etc/letsencrypt/live/iot.devrekbenimmarketim.com/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/iot.devrekbenimmarketim.com/privkey.pem;
#     
#     # ... yukarıdaki location bloğu buraya da eklenir
# }

