# Nginx Yapılandırma Örneği
# Bu dosyayı /etc/nginx/sites-available/iot-analytics olarak kaydedin
# Domain: devrekbenimmarketim.com için hazırlanmıştır

# HTTP - Ana yapılandırma (ESP8266 için)
server {
    listen 80;
    server_name iot.devrekbenimmarketim.com;  # IoT subdomain

    # Log dosyaları
    access_log /var/log/nginx/iot-analytics-access.log;
    error_log /var/log/nginx/iot-analytics-error.log;

    # Maksimum upload boyutu
    client_max_body_size 1M;

    location / {
        proxy_pass http://localhost:3001;  # IoT projesinin portu (MERN 3000'de)
        
        proxy_http_version 1.1;
        
        # WebSocket desteği
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        
        # Headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Timeout ayarları
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        
        # Cache bypass
        proxy_cache_bypass $http_upgrade;
    }

    # Static dosyalar için cache (opsiyonel)
    location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg)$ {
        proxy_pass http://localhost:3001;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}

# HTTPS - HTTP'ye yönlendir (SSL sertifikası olmadan)
# Bu blok, tarayıcının HTTPS'e yönlendirmesini engellemek için
# Ana domain'in SSL sertifikasını kullanarak HTTP'ye yönlendirir
server {
    listen 443 ssl http2;
    server_name iot.devrekbenimmarketim.com;
    
    # Ana domain'in SSL sertifikasını kullan (geçici çözüm)
    # NOT: Bu bir uyarı verebilir ama çalışır
    ssl_certificate /etc/letsencrypt/live/devrekbenimmarketim.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/devrekbenimmarketim.com/privkey.pem;
    
    # HTTP'ye yönlendir
    return 301 http://$server_name$request_uri;
}

# ============================================
# SSL VERSİYONU (İleride gerekirse)
# ============================================
# SSL sertifikası eklemek isterseniz, yukarıdaki bloğu koruyup
# aşağıdaki bloğu ekleyin:

# server {
#     listen 443 ssl http2;
#     server_name iot.devrekbenimmarketim.com;
#     
#     ssl_certificate /etc/letsencrypt/live/iot.devrekbenimmarketim.com/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/iot.devrekbenimmarketim.com/privkey.pem;
#     
#     ssl_protocols TLSv1.2 TLSv1.3;
#     ssl_ciphers HIGH:!aNULL:!MD5;
#     ssl_prefer_server_ciphers on;
#     
#     # ... yukarıdaki location bloğu buraya da eklenir
# }

